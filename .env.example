# Copy to .env and customize for your Google Cloud project
PROJECT_ID=your-gcp-project-id
REGION=asia-southeast1
CLUSTER_ID=summit-trail-cluster
PRIMARY_ID=summit-trail-primary
POOL_ID=summit-trail-agent-pool

# Default: global AlloyDB Remote MCP Server (works from Cloud Shell & laptops)
# After upgrading to Agent Mode inside agents-vpc, switch to https://<MCP_HOST>
MCP_URL=https://alloydb.googleapis.com
DATABASE=inventory_db
CA_PEM_PATH=ca.pem
